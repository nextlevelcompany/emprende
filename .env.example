# =====================================================================
# .env.example — Variables de entorno para Caja Emprende Chambala
# Copia este archivo a .env y asigna valores reales en tu entorno local.
# NUNCA subas archivos .env con credenciales reales a control de versiones.
# =====================================================================

# PostgreSQL
POSTGRES_PORT=5433
POSTGRES_DB=caja_chambala
POSTGRES_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-unique-random-password
DB_APP_RW_PASSWORD=replace-with-a-unique-random-password
DB_APP_RO_PASSWORD=replace-with-a-unique-random-password
RLS_CONTEXT_HMAC_SECRET_HEX=replace-with-64-cryptographically-random-hex-characters

# Spring Boot Backend
SPRING_PROFILES_ACTIVE=dev
PORT=8080
JWT_SECRET=replace-with-a-unique-random-secret
# Conserva la clave histórica mientras existan datos cifrados con ella; rótala tras migrar esos datos.
AES_GCM_ENCRYPTION_KEY=replace-with-a-new-random-64-hex-character-key
ADMIN_DEFAULT_PASSWORD=replace_with_a_unique_local_admin_password
APP_CORS_ALLOWED_ORIGIN=http://localhost:3000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@cajachambala.pe
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
FRONTEND_BASE_URL=http://localhost:3000

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
BACKEND_INTERNAL_URL=http://backend:8080/api/v1

# Producción (configura DNS público y TLS al usar docker-compose.prod.yml)
APP_DOMAIN=app.example.com
