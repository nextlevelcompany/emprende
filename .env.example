# =====================================================================
# .env.example — Variables de entorno para Caja Emprende Chambala
# Copia este archivo a .env y asigna valores reales en tu entorno local.
# NUNCA subas archivos .env con credenciales reales a control de versiones.
# =====================================================================

# PostgreSQL
POSTGRES_PORT=5433
POSTGRES_DB=caja_chambala
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_super_secret_postgres_pass
DB_APP_RW_PASSWORD=dev_password_rw
DB_APP_RO_PASSWORD=dev_password_ro

# Spring Boot Backend
SPRING_PROFILES_ACTIVE=dev
PORT=8080
JWT_SECRET=dev_very_secure_secret_key_minimum_256_bits_length_1234567890
AES_GCM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_SEARCH_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
BACKEND_INTERNAL_URL=http://backend:8080/api/v1
